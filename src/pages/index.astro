---
import '../styles/global.css';
import { propiedades, NUMERO_WHATSAPP } from '../data/propiedades.js';

function linkWhatsApp(p) {
  const precioTexto = p.mostrarPrecio ? p.precio : 'Precio a consultar';
  const imagen = p.foto.startsWith('http') ? p.foto : new URL(p.foto, Astro.site).href;
  const texto = encodeURIComponent(
    `¡Hola! Quiero consultar disponibilidad sobre la propiedad: *${p.titulo}* (${precioTexto})\n\n${imagen}`
  );
  return `https://wa.me/${NUMERO_WHATSAPP}?text=${texto}`;
}
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Encuentra tu Propiedad Ideal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <header class="hero">
        <span class="hero-badge"><i class="fa-solid fa-house"></i> Asesoría inmobiliaria</span>
        <h1>Tu nuevo hogar <span>te espera</span></h1>
        <p>Trato directo y sin intermediarios. Casas, terrenos y departamentos a tu medida.</p>
        <div class="hero-actions">
            <a href="#" class="hero-btn hero-btn--main" onclick="contactoDirecto(event)">
                <i class="fa-brands fa-whatsapp"></i> Hablar con un asesor
            </a>
            <a href="#propiedades" class="hero-btn hero-btn--ghost">Ver propiedades</a>
        </div>
    </header>

    <div class="container">

        <div class="funnel-card">
            <h2><i class="fa-solid fa-filter"></i> ¿Qué estás buscando?</h2>

            <div class="form-group">
                <label for="tipo">Tipo de Propiedad</label>
                <select id="tipo">
                    <option value="Casa">Casa</option>
                    <option value="Departamento">Departamento</option>
                    <option value="Terreno">Terreno / Lote</option>
                    <option value="Local Comercial">Local Comercial</option>
                </select>
            </div>

            <div class="form-group">
                <label for="operacion">Operación</label>
                <select id="operacion">
                    <option value="Comprar">Comprar</option>
                    <option value="Alquilar">Alquilar</option>
                </select>
            </div>

            <div class="form-group">
                <label for="presupuesto">Presupuesto Estimado</label>
                <input type="text" id="presupuesto" placeholder="Ej. $80,000 / L. 1,500,000">
            </div>

            <button type="button" class="btn-whatsapp" onclick="enviarAWhatsApp()">
                <i class="fa-brands fa-whatsapp"></i> Consultar por WhatsApp
            </button>
        </div>

        <div class="benefits">
            <div class="benefit-item">
                <i class="fa-solid fa-check-circle"></i> Trato Directo
            </div>
            <div class="benefit-item">
                <i class="fa-solid fa-clock"></i> Respuesta Inmediata
            </div>
        </div>

        <h3 class="section-title" id="propiedades">Propiedades Disponibles</h3>

        {propiedades.map((p) => (
            <div class="property-card">
                <img src={p.foto} alt={p.titulo} class="property-img">
                <div class="property-content">
                    <div class="property-price-row">
                        <div class="property-price">{p.mostrarPrecio ? p.precio : 'Precio a consultar'}</div>
                        <span class={`property-status ${p.estado === 'vendida' ? 'property-status--vendida' : 'property-status--venta'}`}>
                            {p.estado === 'vendida' ? 'Vendida' : 'En venta'}
                        </span>
                    </div>
                    {p.financiamiento && (
                        <div class="property-financing"><i class="fa-solid fa-hand-holding-dollar"></i> Financiamiento disponible</div>
                    )}
                    <div class="property-title">{p.titulo}</div>
                    <div class="property-features">
                        <span><i class="fa-solid fa-bed"></i> {p.habitaciones} Hab</span>
                        <span><i class="fa-solid fa-bath"></i> {p.banos} Baños</span>
                        <span><i class="fa-solid fa-car"></i> {p.estacionamientos} Est.</span>
                    </div>
                    <div class="property-actions">
                        <a href={linkWhatsApp(p)} target="_blank" rel="noopener" class="btn-whatsapp btn-whatsapp--small">
                            <i class="fa-brands fa-whatsapp"></i> Preguntar
                        </a>
                        <a href={`/propiedades/${p.slug}/`} class="btn-secondary">
                            <i class="fa-solid fa-circle-info"></i> Detalles
                        </a>
                    </div>
                </div>
            </div>
        ))}

        <footer>
            <p>&copy; 2026 Agente Inmobiliario. Todos los derechos reservados.</p>
        </footer>

    </div>

    <a href="#" class="float-whatsapp" onclick="contactoDirecto(event)" title="Contactar por WhatsApp">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <script is:inline>
        const NUMERO_WHATSAPP = "50492090910";

        function enviarAWhatsApp() {
            const tipo = document.getElementById('tipo').value;
            const operacion = document.getElementById('operacion').value;
            const presupuesto = document.getElementById('presupuesto').value || "No especificado";

            const texto = `¡Hola! Me interesa obtener información sobre propiedades:%0A` +
                          `• *Tipo:* ${tipo}%0A` +
                          `• *Operación:* ${operacion}%0A` +
                          `• *Presupuesto:* ${presupuesto}%0A%0A` +
                          `¿Me podría brindar más detalles?`;

            window.open(`https://wa.me/${NUMERO_WHATSAPP}?text=${texto}`, '_blank');
        }

        function contactoDirecto(e) {
            e.preventDefault();
            const texto = `¡Hola! Quisiera hablar con un asesor sobre propiedades disponibles.`;
            window.open(`https://wa.me/${NUMERO_WHATSAPP}?text=${texto}`, '_blank');
        }
    </script>
</body>
  </html>